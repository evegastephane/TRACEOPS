{
  "name": "traceops",
  "version": "0.1.0",
  "description": "TRACEOPS backend foundation",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-migrations.mjs",
    "test": "npm run build && node --test dist/test/*.test.js",
    "start": "node --env-file=.env dist/src/main.js",
    "start:ci": "node dist/src/main.js",
    "db:migrate": "node --env-file=.env dist/src/migrate.js",
    "build:web": "tsc -p apps/web/tsconfig.json && vite build --config apps/web/vite.config.ts apps/web && node scripts/copy-prototype.mjs",
    "dev:web": "vite --config apps/web/vite.config.ts apps/web",
    "admin:bootstrap": "node --env-file=.env dist/src/bootstrap-admin.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evegastephane/TRACEOPS.git"
  },
  "keywords": [],
  "author": "",
  "type": "module",
  "bugs": {
    "url": "https://github.com/evegastephane/TRACEOPS/issues"
  },
  "homepage": "https://github.com/evegastephane/TRACEOPS#readme",
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "cookie-parser": "1.4.7",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@playwright/test": "1.64.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "private": true,
  "engines": {
    "node": ">=24"
  }
}
